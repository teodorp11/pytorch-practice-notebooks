   "source": [
    "class Car:\n",
    "    def __init__(self, color, mileage):\n",
    "        self.color = color\n",
    "        self.mileage = mileage\n",
    "    \n",
    "    def __str__(self):\n",
    "        return f\"The {self.color} car has {self.mileage:,} miles.\"\n",
    "\n",
    "car1 = Car(\"blue\", 20000)\n",
    "car2 = Car(\"red\", 30000)\n",
    "\n",
    "print(car1)\n",
    "print(car2)"
   ]
  }
